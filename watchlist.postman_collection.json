{
  "info": {
    "name": "Movie Watchlist API",
    "description": "Run 'Log in' first: it saves the token into the {{token}} variable used by the protected requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3001" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "Register",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"hong@test.com\",\n  \"password\": \"secret123\"\n}" },
        "url": "{{baseUrl}}/auth/register"
      }
    },
    {
      "name": "Log in",
      "event": [
        {
          "listen": "test",
          "script": { "exec": ["pm.collectionVariables.set('token', pm.response.json().accessToken);"] }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"hong@test.com\",\n  \"password\": \"secret123\"\n}" },
        "url": "{{baseUrl}}/auth/login"
      }
    },
    {
      "name": "1. List all movies",
      "request": { "method": "GET", "url": "{{baseUrl}}/movies" }
    },
    {
      "name": "2. Get one movie",
      "request": { "method": "GET", "url": "{{baseUrl}}/movies/1" }
    },
    {
      "name": "3a. Create a movie",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"title\": \"Inception\",\n  \"genre\": \"Sci-Fi\"\n}" },
        "url": "{{baseUrl}}/movies"
      }
    },
    {
      "name": "3b. Create a movie - empty title (400)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"title\": \"\",\n  \"genre\": \"Sci-Fi\"\n}" },
        "url": "{{baseUrl}}/movies"
      }
    },
    {
      "name": "4. Mark a movie as watched",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"watched\": true\n}" },
        "url": "{{baseUrl}}/movies/1"
      }
    },
    {
      "name": "5. Delete a movie",
      "request": {
        "method": "DELETE",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/movies/2"
      }
    },
    {
      "name": "6. Missing movie (404)",
      "request": { "method": "GET", "url": "{{baseUrl}}/movies/99" }
    },
    {
      "name": "7a. Create without a token (401)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"title\": \"Interstellar\",\n  \"genre\": \"Sci-Fi\"\n}" },
        "url": "{{baseUrl}}/movies"
      }
    },
    {
      "name": "7b. Same request with a token (201)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"title\": \"Interstellar\",\n  \"genre\": \"Sci-Fi\"\n}" },
        "url": "{{baseUrl}}/movies"
      }
    }
  ]
}
